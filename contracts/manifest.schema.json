{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WildScope manifest (A-01)",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "snapshot", "retrievedAt", "build", "constants", "bins", "lenses", "filters", "species", "assets", "sizeReport", "attribution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9]+)*$" },
    "snapshot": {
      "type": "object",
      "required": ["id", "source", "registryUrl", "parts", "bytes"],
      "properties": { "id": { "type": "string" }, "source": { "type": "string" }, "parts": { "type": "integer" }, "citation": { "type": ["string", "null"] } }
    },
    "retrievedAt": { "type": "string", "format": "date" },
    "build": {
      "type": "object",
      "required": ["kind", "partsRead", "partsTotal", "lensesBuilt", "resolutions"],
      "properties": { "kind": { "enum": ["full", "sample", "country"] }, "resolutions": { "type": "array", "items": { "enum": [2, 4, 6] } } }
    },
    "constants": {
      "type": "object",
      "required": ["MIN_EFFORT", "MIN_SPECIES_RECORDS", "MAX_UNCERTAINTY_M", "MIN_YEAR"],
      "additionalProperties": { "type": "integer" }
    },
    "bins": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": { "type": "object", "required": ["id", "label", "tick", "from", "to"], "properties": { "id": { "pattern": "^B0[0-8]$" } } }
    },
    "lenses": {
      "type": "object",
      "required": ["animals", "trees"],
      "properties": {
        "animals": {
          "type": "object",
          "required": ["built", "groups", "totalsByBin"],
          "properties": {
            "groups": { "type": "array", "items": { "type": "object", "required": ["id", "label", "index"] } },
            "totalsByBin": { "type": "object", "additionalProperties": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "integer", "minimum": 0 } } }
          }
        },
        "trees": { "type": "object", "required": ["built"] }
      }
    },
    "filters": {
      "type": "object",
      "required": ["rowsRead", "kept", "stages"],
      "properties": {
        "stages": { "type": "array", "minItems": 9, "items": { "type": "object", "required": ["id", "rule", "dropped"], "properties": { "dropped": { "type": "integer", "minimum": 0 } } } }
      }
    },
    "species": { "type": "object", "required": ["count", "searchPrefixes"], "properties": { "searchPrefixes": { "type": "array", "items": { "pattern": "^[a-z]{2}$" } } } },
    "assets": {
      "type": "object",
      "required": ["cells"],
      "properties": {
        "cells": { "type": "object", "additionalProperties": { "type": "object", "required": ["sha256", "bytes", "brotliBytes", "cells"] } }
      }
    },
    "attribution": { "type": "array", "items": { "type": "string" } }
  }
}
